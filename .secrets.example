# Required for new Ping measurements; also enables verification experiences.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_HOSTNAMES=

# Optional: Tianditu browser map token. Missing or unavailable Tianditu falls back to OpenStreetMap.
TIANDITU_TOKEN=

# Optional second widget: configure its mode as Non-interactive in Cloudflare.
TURNSTILE_NONINTERACTIVE_SITE_KEY=
TURNSTILE_NONINTERACTIVE_SECRET=
TURNSTILE_NONINTERACTIVE_HOSTNAMES=
